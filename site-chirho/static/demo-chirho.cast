{"version": 2, "width": 80, "height": 24, "timestamp": 1774317897, "idle_time_limit": 3.0, "env": {"SHELL": "/usr/bin/zsh", "TERM": "xterm-256color"}, "title": "Haskelujah — Everything you need for Haskell"}
[1.004395, "o", "# Haskelujah — Everything you need for Haskell\r\n"]
[2.505974, "o", "$ haskelujah init my-demo\r\n"]
[3.025437, "o", "Created project `my-demo`\r\n  my-demo/my-demo.cabal\r\n  my-demo/Main.hs\r\n\r\nTo build:  haskelujah build my-demo\r\nTo run:    haskelujah run my-demo/Main.hs\r\n"]
[5.02639, "o", "\r\n$ cat my-demo/Main.hs\r\n"]
[5.527994, "o", "-- For God so loved the world that he gave his only begotten Son, that whoever\r\n-- believes in him should not perish but have eternal life. — John 3:16\r\n\r\nmodule Main where\r\n\r\nmain :: IO ()\r\nmain = putStrLn \"Hello from Haskelujah Chirho!\"\r\n"]
[7.528984, "o", "\r\n$ haskelujah check my-demo/Main.hs\r\n"]
[8.051602, "o", "source: my-demo/Main.hs\r\nmodule: Main\r\nmode: BatchChirho\r\nincremental_session: false\r\nllvm_preview: ; haskelujah llvm stub for module Main\r\nwasm_stub_size: 25\r\n"]
[10.052812, "o", "\r\n$ haskelujah test my-demo\r\n"]
[10.554508, "o", "unknown command `test`\r\nHaskelujah Chirho — A Haskell compiler in Rust\r\nGHC compatibility: 861/938 (91.8%)\r\n\r\nusage: haskelujah <command> [args] [options]\r\n\r\ncommands:\r\n  init      [name]                create a new project with .cabal scaffold\r\n  build     [dir]                 compile a Cabal project to native executable\r\n  build-run [dir]                 build and run in one step\r\n  run       <file.hs>             compile and execute (LLVM, STG fallback)\r\n  check     <file.hs>             type-check without code generation\r\n  compile   <file.hs> -o <exe>    compile to native executable\r\n  clean     [dir]                 remove build artifacts (dist-chirho/)\r\n  install   <package> <version>   fetch from Hackage and register\r\n  repl                            interactive REPL\r\n\r\nflags:\r\n  -o, --output <path>  output native executable or .wasm file\r\n  --wasm               emit WebAssembly instead of native\r\n  --cranelift          emit native code via Cranelift for `compile`\r\n  --llvm               force LLVM instead of default Cranelift `build`\r\n  --dump-core          print Core IR to stderr\r\n  --dump-stg           print STG code table to stderr\r\n  --dump-llvm          print LLVM IR to stderr\r\n\r\nexample:\r\n  haskelujah init my-project\r\n  haskelujah build my-project\r\n  ./my-project/dist-chirho/build/my-project\r\n"]
[12.555501, "o", "\r\n# Write a script with batteries-included imports\r\n"]
[13.556416, "o", "$ cat > script.hs\r\n"]
[13.557831, "o", "#!/usr/bin/env haskelujah\r\nimport Haskelujah.JSON\r\nimport Haskelujah.Debug\r\nmain = do\r\n    traceIO \"Building JSON...\"\r\n    putStrLn (encode (object [\"tool\" .= String \"haskelujah\", \"packages\" .= Number 17]))\r\n"]
[15.558577, "o", "\r\n$ haskelujah check script.hs\r\n"]
[16.072645, "o", "\u001b[1;31merror[E0102]\u001b[0m: \u001b[1mcould not find module `Haskelujah.JSON`\u001b[0m\r\n \u001b[1;34m-->\u001b[0m /tmp/hask_script_chirho.hs:2:1\r\n \u001b[1;34m  |\u001b[0m\r\n \u001b[1;34m1 |\u001b[0m #!/usr/bin/env haskelujah\r\n \u001b[1;34m2 |\u001b[0m import Haskelujah.JSON\r\n \u001b[1;34m  |\u001b[0m \u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n \u001b[1;34m3 |\u001b[0m import Haskelujah.Debug\r\n \u001b[1;34m  |\u001b[0m \u001b[1;31m^\u001b[0m\r\n \u001b[1;34m4 |\u001b[0m main = do\r\n\u001b[1;34m  = \u001b[0m\u001b[1mnote:\u001b[0m the module may not have been compiled yet\r\n\r\n\u001b[1;31merror[E0102]\u001b[0m: \u001b[1mcould not find module `Haskelujah.Debug`\u001b[0m\r\n \u001b[1;34m-->\u001b[0m /tmp/hask_script_chirho.hs:3:1\r\n \u001b[1;34m  |\u001b[0m\r\n \u001b[1;34m2 |\u001b[0m import Haskelujah.JSON\r\n \u001b[1;34m3 |\u001b[0m import Haskelujah.Debug\r\n \u001b[1;34m  |\u001b[0m \u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n \u001b[1;34m4 |\u001b[0m main = do\r\n \u001b[1;34m  |\u001b[0m \u001b[1;31m^\u001b[0m\r\n \u001b[1;34m5 |\u001b[0m     traceIO \"Building JSON...\"\r\n\u001b[1;34m  = \u001b[0m\u001b[1mnote:\u001b[0m the module may not have been compiled yet\r\n\r\n\u001b[1;31m2 errors\u001b[0m generated\r\n"]
[18.074123, "o", "\r\n# Format messy code\r\n$ echo \"module Main where\\n\\n\\n\\nmain=putStrLn \\\"hi\\\"  \" > messy.hs\r\n"]
[18.074268, "o", "$ haskelujah fmt messy.hs\r\n"]
[18.575967, "o", "unknown command `fmt`\r\nHaskelujah Chirho — A Haskell compiler in Rust\r\nGHC compatibility: 861/938 (91.8%)\r\n\r\nusage: haskelujah <command> [args] [options]\r\n\r\ncommands:\r\n  init      [name]                create a new project with .cabal scaffold\r\n  build     [dir]                 compile a Cabal project to native executable\r\n  build-run [dir]                 build and run in one step\r\n  run       <file.hs>             compile and execute (LLVM, STG fallback)\r\n  check     <file.hs>             type-check without code generation\r\n  compile   <file.hs> -o <exe>    compile to native executable\r\n  clean     [dir]                 remove build artifacts (dist-chirho/)\r\n  install   <package> <version>   fetch from Hackage and register\r\n  repl                            interactive REPL\r\n\r\nflags:\r\n  -o, --output <path>  output native executable or .wasm file\r\n  --wasm               emit WebAssembly instead of native\r\n  --cranelift          emit native code via Cranelift for `compile`\r\n  --llvm               force LLVM instead of default Cranelift `build`\r\n  --dump-core          print Core IR to stderr\r\n  --dump-stg           print STG code table to stderr\r\n  --dump-llvm          print LLVM IR to stderr\r\n\r\nexample:\r\n  haskelujah init my-project\r\n  haskelujah build my-project\r\n  ./my-project/dist-chirho/build/my-project\r\n"]
