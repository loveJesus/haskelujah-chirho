[8.332794, "o", "-- For God so loved the world that he gave his only begotten Son, that whoever\r\n-- believes in him should not perish but have eternal life. -- John 3:16\r\n\r\nmodule Main where\r\n\r\nimport Haskelujah.JSON\r\nimport Haskelujah.Text\r\nimport Haskelujah.Debug\r\n\r\nmain :: IO ()\r\nmain = do\r\ntraceIO \"Starting app...\"\r\nlet greeting = object [\"message\" .= String (capitalize \"hello world\")]\r\nputStrLn (encode greeting)\r\n"]
