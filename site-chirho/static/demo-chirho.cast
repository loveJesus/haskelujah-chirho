[21.5783, "o", "\r\n# MCP server for AI assistants\r\n$ echo '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | haskelujah mcp\r\n"]
[24.170204, "o", "\r\n# 17 Hackage packages compile — transformers + mtl + parsec cascade\r\n# 15 built-in stdlib modules — no install needed\r\n"]
